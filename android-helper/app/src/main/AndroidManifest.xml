<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- The helper is useful on phones; do not make telephony a Play install filter. -->
  <uses-feature
    android:name="android.hardware.telephony"
    android:required="false" />

  <!-- Required to place the call through TelecomManager.placeCall(). -->
  <uses-permission android:name="android.permission.CALL_PHONE" />

  <!--
    Required by TelecomManager.getCallCapablePhoneAccounts() and
    getPhoneAccount() on most Android builds, unless the app is the default
    dialer.
  -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />

  <!--
    Required by TelecomManager.getPhoneAccount() on Android 14+ (the platform
    gates that API behind READ_PHONE_NUMBERS). Needed only to read the account
    label used for SIM selection; the helper never reads phone numbers.
  -->
  <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

  <!-- Best-effort hangup with TelecomManager.endCall(). -->
  <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

  <!-- Required to open the LAN listening socket. No outbound internet is used. -->
  <uses-permission android:name="android.permission.INTERNET" />

  <!-- Foreground service so the socket survives while the phone is idle. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

  <!-- Runtime permission on Android 13+ for the ongoing notification. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Optional: only needed if a partial wake lock is added. -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Optional: only needed if the boot receiver below is enabled. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@drawable/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@android:style/Theme.Material.Light.NoActionBar">

    <activity
      android:name=".MainActivity"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!--
      specialUse is the correct type for a non-dialer app that exposes a local
      control endpoint. The phoneCall type is reserved for apps that own the
      calling experience (default dialer or a self-managed ConnectionService).

      Exported so `adb shell am start-foreground-service` can start it during
      provisioning. The service ignores all intent data; its only control
      surface is the token-protected LAN API.
    -->
    <service
      android:name=".DialService"
      android:exported="true"
      android:foregroundServiceType="specialUse"
      tools:ignore="ExportedService">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Personal LAN endpoint that places outbound calls for a local voice agent" />
    </service>

    <!-- Start the helper after a reboot. Android may block a foreground-service
         start from BOOT_COMPLETED; verify on your device. -->
    <receiver
      android:name=".BootReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
