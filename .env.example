# Environment overrides for the telephone agent.
#
# Copy to .env and edit, but do not commit the populated file. The runtime does
# not parse .env itself; export the variables in the shell or load the file from
# systemd with EnvironmentFile=. For a shell:
#
#   set -a
#   . ./.env
#   set +a
#
# Nested keys use a double underscore. Precedence is TOML < environment.
# Replace every placeholder below. The numbers and domains are fictional.

# Destination. Optional if every dial/run call passes --number.
TELEPHONE_AGENT_PHONE_NUMBER=+15555550100

# Bluetooth HFP address. Replace with Phone A's address.
# TELEPHONE_AGENT_AUDIO__BLUETOOTH_ADDRESS=AA:BB:CC:DD:EE:FF
# TELEPHONE_AGENT_AUDIO__NODE_TIMEOUT_S=30

TELEPHONE_AGENT_AUDIO__SAMPLE_RATE=16000

# LAN base URL of the helper app on Phone A. Never port-forward this endpoint.
TELEPHONE_AGENT_DIALER__URL=http://192.168.1.20:8765
TELEPHONE_AGENT_DIALER__TOKEN=replace-with-helper-token

# "echo" for loopback testing, "http" for an OpenAI-compatible provider.
TELEPHONE_AGENT_BRAIN__KIND=http
TELEPHONE_AGENT_BRAIN__BASE_URL=https://api.example.invalid/v1
TELEPHONE_AGENT_BRAIN__API_KEY=replace-with-api-key
TELEPHONE_AGENT_BRAIN__MODEL=replace-with-model

# Grok Voice realtime adapter. Set [realtime].kind = "grok" in the TOML file,
# then export the xAI key here or from a secret EnvironmentFile outside the
# repository. Never commit a populated value.
# XAI_API_KEY=
# TELEPHONE_AGENT_REALTIME__KIND=grok

# Call policy overrides (optional).
# TELEPHONE_AGENT_AGENT__MAX_CALL_SECONDS=300
# TELEPHONE_AGENT_AGENT__SILENCE_TIMEOUT_S=20
# TELEPHONE_AGENT_AGENT__VAD_THRESHOLD=-40
# TELEPHONE_AGENT_AGENT__LANGUAGE=en-IN

# Daemon control socket. Defaults to $XDG_RUNTIME_DIR/telephone-agent.sock.
# TELEPHONE_AGENT_DAEMON__SOCKET=/run/user/1000/telephone-agent.sock

# Inbound answering (requires realtime.kind = "grok").
# TELEPHONE_AGENT_INBOUND__POLL_INTERVAL_S=1.0
# TELEPHONE_AGENT_INBOUND__ANSWER_DELAY_S=1.0

# Opt-in local transcripts. These contain full numbers and conversation text.
# TELEPHONE_AGENT_TRANSCRIPT__ENABLED=true
# TELEPHONE_AGENT_TRANSCRIPT__DIRECTORY=runtime/transcripts
