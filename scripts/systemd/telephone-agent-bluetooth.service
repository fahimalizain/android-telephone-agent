[Unit]
Description=Telephone agent outbound call client (Bluetooth HFP)
Documentation=https://github.com/fahimalizain/android-telephone-agent
# Run this as a systemd *user* unit. It is a one-shot client: it asks the
# long-lived telephone-agent-daemon.service to place one call and waits for the
# result. The daemon owns the audio path and serializes inbound and outbound
# calls. The client still needs the user's PipeWire/WirePlumber session, and the
# ordering below starts the daemon if the timer fired while it was stopped.
After=pipewire.service wireplumber.service telephone-agent-daemon.service
Wants=pipewire.service wireplumber.service telephone-agent-daemon.service

[Service]
Type=oneshot
# %h is the user's home directory. Change the paths if the repository lives
# elsewhere. The .venv must contain the telephone-agent console script.
WorkingDirectory=%h/android-telephone-agent
EnvironmentFile=-%h/android-telephone-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/android-telephone-agent/.venv/bin/telephone-agent --config %h/android-telephone-agent/config/config.toml run
TimeoutStartSec=900
# One activation is one client request to the daemon. Do not add
# Restart=always: a restart would submit another call. The daemon owns the
# audio and the single call slot; if another call is active, this request is
# rejected as busy and the slot is skipped.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
