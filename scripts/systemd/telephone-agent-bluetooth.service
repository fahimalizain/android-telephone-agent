[Unit]
Description=Telephone agent (Bluetooth HFP), one outbound call
Documentation=https://github.com/fahimalizain/android-telephone-agent
# Run this as a systemd *user* unit. The agent must share the PipeWire and
# WirePlumber session that owns the Bluetooth SCO nodes; a system unit running
# as another user cannot reach that session.
After=pipewire.service wireplumber.service
Wants=pipewire.service wireplumber.service

[Service]
Type=oneshot
# %h is the user's home directory. Change the paths if the repository lives
# elsewhere. The .venv must contain the telephone-agent console script.
WorkingDirectory=%h/android-telephone-agent
EnvironmentFile=-%h/android-telephone-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/android-telephone-agent/.venv/bin/telephone-agent --config %h/android-telephone-agent/config/config.toml run
TimeoutStartSec=900
# One activation is one call. Do not add Restart=always: a restart would
# redial. Retries and idempotency belong in the runtime and the slot logic.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
